# Zerodha AI Financial Intelligence Platform - Environment Configuration
# Copy to `.env` and fill in. NEVER commit `.env` or put real keys in this example file.

# 1. AI / LLM  (free key: https://aistudio.google.com/apikey). Optional: without it the app uses offline fallbacks.
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# 2. Backend
ENVIRONMENT=development          # set to "production" on a server (enforces the secrets checks below)
PORT=8000
# Comma-separated list of frontend origins allowed to call the API ("*" is rejected in production)
CORS_ORIGINS=http://localhost:3000

# 3. PostgreSQL
# Local dev: `docker compose up -d db` creates this database automatically.
DATABASE_URL=postgresql://zerodha:zerodha_pw@localhost:5432/zerodha_ai
# Managed examples (use the provider's connection string, add ?sslmode=require):
#   Neon / Supabase: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
#   AWS RDS:         postgresql://USER:PASSWORD@xxxx.ap-south-1.rds.amazonaws.com:5432/DBNAME?sslmode=require

# Used only by docker-compose to create/connect the bundled `db` container
POSTGRES_USER=zerodha
POSTGRES_PASSWORD=zerodha_pw     # dev default (must match DATABASE_URL above). In production use a long random value.
POSTGRES_DB=zerodha_ai

# 4. Authentication (REQUIRED in production, min 32 chars)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
